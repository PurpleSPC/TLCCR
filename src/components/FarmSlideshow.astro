---
import {withBase, imageSrc} from '../lib/paths';
interface Slide {
  photo: string | null;
  alt: string;
  caption: string;
  focus: 'top' | 'upper' | 'center' | 'lower' | 'bottom';
}
interface Props { slides: readonly Slide[]; }
const {slides: suppliedSlides} = Astro.props;
const slides = suppliedSlides.filter(slide => slide.photo);
const focus = {top: '10%', upper: '35%', center: '50%', lower: '65%', bottom: '90%'};
---
{slides.length > 0 && <farm-slideshow class="farm-slideshow" role="region" aria-roledescription="carousel" aria-label="Animals on the farm" tabindex="0">
  <figure class="journal-cover-photo">
    <div class="farm-slideshow-viewport">
      {slides.map((slide, index) => <div class:list={['farm-slide', {'is-active': index === 0}]} role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${slides.length}: ${slide.caption}`} aria-hidden={index !== 0} data-caption={slide.caption}>
        <img src={imageSrc(slide.photo!)} alt={slide.alt} width="1800" height="1350" style={`object-position:center ${focus[slide.focus]}`} fetchpriority={index === 0 ? 'high' : 'low'} loading="eager" decoding="async"/>
      </div>)}
    </div>
    <figcaption class="farm-slideshow-caption">
      <div class="farm-slide-caption"><span data-slide-caption>{slides[0].caption}</span><span class="farm-slide-count" data-slide-count aria-hidden="true">01 / {String(slides.length).padStart(2, '0')}</span></div>
      <div class="farm-slideshow-controls" hidden>
        <button class="farm-slide-arrow farm-slide-previous" type="button" aria-label="Previous photo" data-previous><span aria-hidden="true">←</span></button>
        <div class="farm-slide-dots" role="group" aria-label="Choose a photo">{slides.map((slide,index) => <button class="farm-slide-dot" type="button" aria-label={`Show photo ${index + 1}: ${slide.caption}`} aria-current={index === 0 ? 'true' : undefined} data-slide-target={index}><span aria-hidden="true"></span></button>)}</div>
        <button class="farm-slide-pause" type="button" aria-label="Pause slideshow" data-playback><span data-playback-icon aria-hidden="true">Ⅱ</span><span data-playback-label>Pause</span></button>
        <button class="farm-slide-arrow farm-slide-next" type="button" aria-label="Next photo" data-next><span aria-hidden="true">→</span></button>
      </div>
      <a href={withBase("/animals/")}>Meet our residents <span aria-hidden="true">↗</span></a>
    </figcaption>
  </figure>
  <span class="farm-slideshow-status" role="status" aria-live="polite" aria-atomic="true"></span>
</farm-slideshow>}

<script>
  class FarmSlideshow extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      if (this.cleanup) return;
      const slides = Array.from(this.querySelectorAll<HTMLElement>('.farm-slide'));
      const controls = this.querySelector<HTMLElement>('.farm-slideshow-controls');
      const playback = this.querySelector<HTMLButtonElement>('[data-playback]');
      const label = this.querySelector<HTMLElement>('[data-playback-label]');
      const icon = this.querySelector<HTMLElement>('[data-playback-icon]');
      const caption = this.querySelector<HTMLElement>('[data-slide-caption]');
      const count = this.querySelector<HTMLElement>('[data-slide-count]');
      const status = this.querySelector<HTMLElement>('.farm-slideshow-status');
      const dots = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-slide-target]'));
      if (slides.length < 2 || !controls || !playback || !label || !icon || !caption || !count || !status) return;

      const abort = new AbortController();
      const options = {signal: abort.signal};
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let index = 0;
      let paused = motion.matches;
      let hovered = false;
      let timer: ReturnType<typeof setTimeout> | undefined;
      let pointer: {x: number; y: number} | undefined;
      const clearTimer = () => { if (timer !== undefined) clearTimeout(timer); timer = undefined; };
      const syncPlayback = () => {
        clearTimer();
        playback.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
        label.textContent = paused ? 'Play' : 'Pause';
        icon.textContent = paused ? '▶' : 'Ⅱ';
        this.dataset.playback = paused ? 'paused' : hovered || document.hidden ? 'suspended' : 'playing';
        if (!paused && !hovered && !document.hidden) timer = setTimeout(() => show(index + 1), 6000);
      };
      const show = (next: number, manual = false) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, position) => {
          slide.classList.toggle('is-active', position === index);
          slide.setAttribute('aria-hidden', String(position !== index));
        });
        dots.forEach((dot, position) => {
          if (position === index) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        caption.textContent = slides[index].dataset.caption ?? '';
        count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
        this.dataset.slideIndex = String(index);
        if (manual) {
          paused = true;
          status.textContent = `Photo ${index + 1} of ${slides.length}: ${slides[index].dataset.caption}`;
        }
        syncPlayback();
      };

      this.querySelector('[data-previous]')?.addEventListener('click', () => show(index - 1, true), options);
      this.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1, true), options);
      dots.forEach((dot, position) => dot.addEventListener('click', () => show(position, true), options));
      playback.addEventListener('click', () => { paused = !paused; syncPlayback(); }, options);
      this.addEventListener('focusin', event => {
        // Focusing the play/pause button must not reverse the action about to be clicked.
        if (event.target instanceof Node && playback.contains(event.target)) return;
        paused = true;
        syncPlayback();
      }, options);
      this.addEventListener('pointerenter', event => {
        if (event.pointerType === 'mouse') { hovered = true; syncPlayback(); }
      }, options);
      this.addEventListener('pointerleave', event => {
        if (event.pointerType === 'mouse') { hovered = false; syncPlayback(); }
      }, options);
      this.addEventListener('keydown', event => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        show(index + (event.key === 'ArrowRight' ? 1 : -1), true);
      }, options);
      const viewport = this.querySelector<HTMLElement>('.farm-slideshow-viewport');
      viewport?.addEventListener('pointerdown', event => { pointer = {x:event.clientX,y:event.clientY}; }, options);
      viewport?.addEventListener('pointerup', event => {
        if (pointer) {
          const dx = event.clientX - pointer.x;
          const dy = event.clientY - pointer.y;
          if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1), true);
        }
        pointer = undefined;
      }, options);
      viewport?.addEventListener('pointercancel', () => { pointer = undefined; }, options);
      document.addEventListener('visibilitychange', syncPlayback, options);
      motion.addEventListener('change', () => { if (motion.matches) paused = true; syncPlayback(); }, options);
      controls.hidden = false;
      this.dataset.slideIndex = '0';
      syncPlayback();
      this.cleanup = () => { clearTimer(); abort.abort(); this.cleanup = undefined; };
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('farm-slideshow')) customElements.define('farm-slideshow', FarmSlideshow);
</script>

<style>
  .farm-slideshow { --slide-height:345px; display:block; position:relative; }
  .farm-slideshow:focus-visible { outline:3px solid var(--farm-blue); outline-offset:6px; }
  .farm-slideshow-viewport { height:var(--slide-height); position:relative; overflow:hidden; background:var(--farm-green); touch-action:pan-y; }
  .farm-slide { position:absolute; inset:0; opacity:0; transition:opacity 850ms ease; }
  .farm-slide.is-active { opacity:1; }
  .farm-slide img { width:100%; height:100%; object-fit:cover; }
  .farm-slideshow .farm-slideshow-caption { display:grid; grid-template-columns:1fr auto 1fr; gap:15px; padding-block:3px; min-height:54px; }
  .farm-slide-caption { display:flex; align-items:center; gap:16px; font-size:9px; letter-spacing:.08em; text-transform:uppercase; line-height:1.5; }
  .farm-slide-count { white-space:nowrap; font-size:10px; letter-spacing:.08em; color:var(--farm-red); }
  .farm-slideshow-controls { display:flex; align-items:center; gap:12px; }
  .farm-slideshow-controls[hidden] { display:none; }
  .farm-slideshow button { font:inherit; cursor:pointer; border:0; touch-action:manipulation; }
  .farm-slideshow button:focus-visible { outline:3px solid var(--farm-blue); outline-offset:2px; }
  .farm-slide-dots { display:flex; align-items:center; }
  .farm-slide-dot { display:grid; place-items:center; width:34px; height:44px; padding:0; background:transparent; color:var(--farm-green); }
  .farm-slide-dot span { width:7px; height:7px; border:1px solid currentColor; border-radius:50%; }
  .farm-slide-dot[aria-current=true] { color:var(--farm-red); }
  .farm-slide-dot[aria-current=true] span { background:currentColor; transform:scale(1.3); }
  .farm-slide-pause { display:flex; align-items:center; justify-content:center; gap:7px; min-width:74px; height:44px; background:transparent; color:var(--farm-green); font-size:11px!important; }
  .farm-slide-pause:hover { color:var(--farm-red); }
  .farm-slide-arrow { position:absolute; z-index:2; top:calc(var(--slide-height) / 2 - 17px); display:grid; place-items:center; width:44px; height:44px; padding:0; background:var(--farm-green); color:var(--farm-cream); border:1px solid #fff9e980!important; font-size:23px!important; line-height:1; }
  .farm-slide-arrow:hover { background:var(--farm-red); }
  .farm-slide-previous { left:15px; }
  .farm-slide-next { right:15px; }
  .farm-slideshow-caption > a { justify-self:end; }
  .farm-slideshow-status { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
  @media(max-width:1180px) { .farm-slideshow { --slide-height:320px; } }
  @media(max-width:600px) {
    .farm-slideshow { --slide-height:270px; }
    .farm-slideshow .farm-slideshow-caption { grid-template-columns:1fr auto; gap:0 12px; padding-block:9px 0; }
    .farm-slide-caption { font-size:8px; gap:10px; }
    .farm-slide-count { font-size:9px; }
    .farm-slideshow-controls { grid-row:2; grid-column:1 / -1; justify-content:center; gap:16px; }
    .farm-slide-dot { width:44px; }
    .farm-slide-arrow { width:40px; height:44px; }
    .farm-slide-previous { left:9px; }
    .farm-slide-next { right:9px; }
  }
  @media(prefers-reduced-motion:reduce) { .farm-slide { transition:none; } }
</style>
