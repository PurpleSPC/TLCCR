---
import {withBase, imageSrc} from '../../lib/paths';
import FarmLayout from '../../layouts/FarmLayout.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import {inquiryTypes} from '../../lib/inquiries.mjs';
import {getSettings} from '../../lib/content';
export function getStaticPaths() { return Object.entries(inquiryTypes).map(([kind, info]) => ({params:{kind}, props:{kind, info}})); }
const {kind, info} = Astro.props;
const settings = await getSettings();
---
<FarmLayout title={info.title}>
  <section class="inquiry-page-heading concept-wrap"><a class="inquiry-back" href={withBase("/schedule/")}>← Choose a different visit type</a><span class="concept-eyebrow">{info.eyebrow}</span><h1>{info.headline}</h1><p>{info.intro}</p></section>
  <section class="inquiry-layout concept-wrap">
    <InquiryForm kind={kind} title={info.title}/>
    <aside class="inquiry-aside"><img src={imageSrc(info.photo)} alt={info.alt} width="800" height="600"/><div><span class="concept-eyebrow">A LITTLE HELP BEFORE YOU START</span><h2>{kind === 'visit' ? 'A visit, arranged around you.' : kind === 'volunteer' ? 'Start with a conversation.' : 'Big questions welcome.'}</h2><p>{kind === 'visit' ? 'Preferred dates and times are requests. The farm will confirm availability and details before you come.' : kind === 'volunteer' ? 'This is an initial inquiry. The team can discuss suitable opportunities and any next steps with you.' : 'Share your best estimates. The team can discuss group size, learning goals, dates, and any access needs.'}</p><p>Have a question? Give the farm a call.</p><a class="inquiry-phone" href={withBase(`tel:${settings.phone.replace(/[^\d+]/g,'')}`)}>{settings.phone}</a><p class="inquiry-location">Palm City, Florida<br/>Visits by arrangement.</p></div></aside>
  </section>
</FarmLayout>
